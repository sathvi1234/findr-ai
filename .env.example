# Copy to .env and fill in. Do not commit .env.

# Atlas connection string from Database Access + Network Access.
# Example shape only. Replace the user, password, and host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=findr_ai

# Shared demo token for the FastAPI routes. This is not a user password.
DEMO_API_TOKEN=replace-with-a-long-random-string

# Durable disk path for the SQLite hash chain. Do not point this at an ephemeral disk.
FINDR_AUDIT_DB=data/findr_audit.db

# Comma-separated public dashboard origins allowed to call the API. Leave empty to disable CORS.
FINDR_CORS_ORIGINS=
